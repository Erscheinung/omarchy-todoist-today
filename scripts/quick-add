#!/usr/bin/env python3
"""Safely add one task through Todoist's official td CLI.

Adapted from todoist-bridge by David Ojeda Lopez:
https://github.com/davidojedalopez/omarchy-todoist
"""

import json
import os
import shutil
import subprocess
import sys

MAX_TASK_CHARS = 4096
MAX_OUTPUT_BYTES = 256 * 1024


def emit(ok, message="", **fields):
    print(json.dumps({"ok": ok, "message": message, **fields}, separators=(",", ":")))
    return 0 if ok else 1


def failure_message(stderr, stdout):
    sample = (stderr[:8192] + b"\n" + stdout[:8192]).decode("utf-8", "replace").lower()
    if "not authenticated" in sample or "login" in sample:
        return "Run td auth login first"
    if "multiple accounts" in sample or "select an account" in sample:
        return "Select an account with td accounts use"
    if "read-only" in sample or "read only" in sample:
        return "td is authenticated read-only"
    if "network" in sample or "connection" in sample or "fetch failed" in sample:
        return "td could not reach Todoist"
    return "td rejected the task"


def td_path():
    override = os.environ.get("TODOIST_TD_BIN")
    if override:
        return override if os.path.isfile(override) and os.access(override, os.X_OK) else None
    executable = shutil.which("td")
    if executable:
        return executable
    mise = shutil.which("mise")
    if not mise:
        return None
    try:
        lookup = subprocess.run(
            [mise, "which", "td"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    candidate = lookup.stdout.decode("utf-8", "replace").strip()
    return candidate if lookup.returncode == 0 and os.path.isfile(candidate) and os.access(candidate, os.X_OK) else None


def run_td(executable, args, stdin_text=None):
    command_env = {
        **os.environ,
        "NO_COLOR": "1",
        "PATH": os.path.dirname(executable) + os.pathsep + os.environ.get("PATH", ""),
    }
    try:
        process = subprocess.run(
            [executable, "--no-spinner", *args],
            input=None if stdin_text is None else stdin_text.encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            env=command_env,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return None, "td timed out"
    except OSError:
        return None, "Could not start td"
    if len(process.stdout) > MAX_OUTPUT_BYTES or len(process.stderr) > MAX_OUTPUT_BYTES:
        return None, "td returned too much data"
    if process.returncode != 0:
        return None, failure_message(process.stderr, process.stdout)
    try:
        response = json.loads(process.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None, "td returned an unreadable response"
    return response, ""


def main():
    executable = td_path()
    if not executable:
        return emit(False, "Install @doist/todoist-cli and run td auth login")

    command = sys.argv[1] if len(sys.argv) > 1 else "add"
    if command == "projects":
        response, failure = run_td(executable, ["project", "list", "--all", "--json"])
        if failure:
            return emit(False, failure)
        rows = response.get("results") if isinstance(response, dict) else None
        if not isinstance(rows, list):
            return emit(False, "td returned an unreadable response")
        projects = []
        for row in rows[:500]:
            name = row.get("name") if isinstance(row, dict) else None
            if isinstance(name, str):
                name = "".join(char for char in name if char >= " " and char != "\x7f").strip()
                if name:
                    projects.append(name[:200])
        return emit(True, projects=projects)
    if command != "add":
        return emit(False, "Unknown quick-add command")

    task = sys.stdin.readline(MAX_TASK_CHARS + 2)
    if len(task) > MAX_TASK_CHARS + 1:
        return emit(False, "Task is too long")
    task = task.strip()
    if not task:
        return emit(False, "Enter a task")

    response, failure = run_td(
        executable, ["task", "quickadd", "--stdin", "--json"], task
    )
    if failure:
        return emit(False, failure)
    if not isinstance(response, dict):
        return emit(False, "td returned an unreadable response")
    return emit(True)


if __name__ == "__main__":
    raise SystemExit(main())
