#!/usr/bin/env python3
"""Safely add one task through Todoist's official td CLI.

Adapted from todoist-bridge by David Ojeda Lopez:
https://github.com/davidojedalopez/omarchy-todoist
"""

import json
import os
import selectors
import shutil
import subprocess
import sys
import time

MAX_TASK_CHARS = 4096
MAX_OUTPUT_BYTES = 256 * 1024


def emit(ok, message="", **fields):
    print(json.dumps({"ok": ok, "message": message, **fields}, separators=(",", ":")))
    return 0 if ok else 1


def failure_message(stderr, stdout):
    sample = (stderr[:8192] + b"\n" + stdout[:8192]).decode("utf-8", "replace").lower()
    if "not authenticated" in sample or "login" in sample:
        return "Run td auth login first"
    if "multiple accounts" in sample or "select an account" in sample:
        return "Select an account with td accounts use"
    if "read-only" in sample or "read only" in sample:
        return "td is authenticated read-only"
    if "network" in sample or "connection" in sample or "fetch failed" in sample:
        return "td could not reach Todoist"
    return "td rejected the task"


def stop_process(process):
    if process.poll() is None:
        try:
            process.kill()
        except ProcessLookupError:
            pass
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def bounded_run(command, input_bytes=None, timeout=15, env=None, capture_stderr=True):
    process = None
    selector = selectors.DefaultSelector()
    streams = {}
    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.PIPE if input_bytes is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE if capture_stderr else subprocess.DEVNULL,
            env=env,
        )
        if input_bytes is not None:
            try:
                process.stdin.write(input_bytes)
                process.stdin.close()
            except BrokenPipeError:
                process.stdin.close()

        output = {"stdout": bytearray(), "stderr": bytearray()}
        for name, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
            if stream is None:
                continue
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, name)
            streams[stream] = name

        deadline = time.monotonic() + timeout
        while streams:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                stop_process(process)
                return None, None, None, "timeout"
            ready = selector.select(remaining)
            if not ready:
                stop_process(process)
                return None, None, None, "timeout"

            for event, _ in ready:
                stream = event.fileobj
                try:
                    chunk = os.read(stream.fileno(), 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(stream)
                    streams.pop(stream, None)
                    stream.close()
                    continue
                name = streams[stream]
                if len(output[name]) + len(chunk) > MAX_OUTPUT_BYTES:
                    stop_process(process)
                    return None, None, None, "too_much_output"
                output[name].extend(chunk)

        remaining = deadline - time.monotonic()
        if remaining <= 0:
            stop_process(process)
            return None, None, None, "timeout"
        try:
            return bytes(output["stdout"]), bytes(output["stderr"]), process.wait(timeout=remaining), ""
        except subprocess.TimeoutExpired:
            stop_process(process)
            return None, None, None, "timeout"
    except OSError:
        if process is not None:
            stop_process(process)
        return None, None, None, "start"
    finally:
        selector.close()
        for stream in streams:
            stream.close()


def td_path():
    override = os.environ.get("TODOIST_TD_BIN")
    if override:
        return override if os.path.isfile(override) and os.access(override, os.X_OK) else None
    executable = shutil.which("td")
    if executable:
        return executable
    mise = shutil.which("mise")
    if not mise:
        return None
    stdout, _, returncode, failure = bounded_run(
        [mise, "which", "td"], timeout=3, capture_stderr=False
    )
    if failure:
        return None
    candidate = stdout.decode("utf-8", "replace").strip()
    return candidate if returncode == 0 and os.path.isfile(candidate) and os.access(candidate, os.X_OK) else None


def run_td(executable, args, stdin_text=None):
    command_env = {
        **os.environ,
        "NO_COLOR": "1",
        "PATH": os.path.dirname(executable) + os.pathsep + os.environ.get("PATH", ""),
    }
    stdout, stderr, returncode, failure = bounded_run(
        [executable, "--no-spinner", *args],
        input_bytes=None if stdin_text is None else stdin_text.encode("utf-8"),
        timeout=15,
        env=command_env,
    )
    if failure == "timeout":
        return None, "td timed out"
    if failure == "too_much_output":
        return None, "td returned too much data"
    if failure:
        return None, "Could not start td"
    if returncode != 0:
        return None, failure_message(stderr, stdout)
    try:
        response = json.loads(stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None, "td returned an unreadable response"
    return response, ""


def main():
    executable = td_path()
    if not executable:
        return emit(False, "Install @doist/todoist-cli and run td auth login")

    command = sys.argv[1] if len(sys.argv) > 1 else "add"
    if command == "projects":
        response, failure = run_td(executable, ["project", "list", "--all", "--json"])
        if failure:
            return emit(False, failure)
        rows = response.get("results") if isinstance(response, dict) else None
        if not isinstance(rows, list):
            return emit(False, "td returned an unreadable response")
        projects = []
        for row in rows[:500]:
            name = row.get("name") if isinstance(row, dict) else None
            if isinstance(name, str):
                name = "".join(char for char in name if char >= " " and char != "\x7f").strip()
                if name:
                    projects.append(name[:200])
        return emit(True, projects=projects)
    if command != "add":
        return emit(False, "Unknown quick-add command")

    task = sys.stdin.readline(MAX_TASK_CHARS + 2)
    if len(task) > MAX_TASK_CHARS + 1:
        return emit(False, "Task is too long")
    task = task.strip()
    if not task:
        return emit(False, "Enter a task")

    response, failure = run_td(
        executable, ["task", "quickadd", "--stdin", "--json"], task
    )
    if failure:
        return emit(False, failure)
    if not isinstance(response, dict):
        return emit(False, "td returned an unreadable response")
    return emit(True)


if __name__ == "__main__":
    raise SystemExit(main())
